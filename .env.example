# Copy this file to .env. Never commit real secrets.

# Stock footage search and download
PEXELS_API_KEY=

# Cloud voiceover and long-tail sound-effect generation
ELEVENLABS_API_KEY=

# Optional AI background-music generation through Google Lyria
GEMINI_API_KEY=

